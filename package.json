{
  "name": "humanhash",
  "version": "0.0.1",
  "description": "Deterministic, human-readable names for UUIDs and hexadecimal digests.",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/test_*.js",
    "test:coverage": "node --test --experimental-test-coverage test/test_*.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustywusty/human-hash-js.git"
  },
  "author": "",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/dustywusty/human-hash-js/issues"
  },
  "homepage": "https://github.com/dustywusty/human-hash-js#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "index.js",
    "lib/"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8"
  }
}
